---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/brand/Button.astro";
import { getRoute } from "../i18n/utils";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const publicKey = import.meta.env.PUBLIC_WOMPI_PUBLIC_KEY ?? "";
const donarUrl = base + getRoute("donar", "es");
---
<BaseLayout routeKey="gracias" title="¡Gracias!" description="Gracias por sumarte a El Club del 1+." noindex>
  <section class="ground-paper section thanks" id="thanks-root" data-wompi-public-key={publicKey}>
    <div class="container thanks__inner">
      <div data-state-view="checking">
        <p class="thanks__lead">Verificando tu pago…</p>
      </div>

      <div data-state-view="approved" hidden>
        <h1 class="display thanks__title">¡Gracias por sumarte! 💚</h1>
        <p class="thanks__lead">Tu aporte acerca a una madre cabeza de familia a su renta básica. Te enviaremos la confirmación a tu correo.</p>
        <p class="thanks__ref" data-thanks-ref hidden>Referencia de tu transacción: <span class="thanks__refval"></span></p>
        <div class="thanks__actions">
          <Button href={base + "/"} variant="dark" size="lg">Volver al inicio</Button>
          <Button href="https://instagram.com/clubdel1_" variant="outline" size="lg" target="_blank">Síguenos · @clubdel1_</Button>
        </div>
      </div>

      <div data-state-view="pending" hidden>
        <h1 class="display thanks__title thanks__title--warning">Tu pago está en proceso</h1>
        <p class="thanks__lead">Wompi todavía está confirmando tu pago (puede pasar con PSE, Nequi u otros medios). Te avisaremos por correo apenas se confirme — no hace falta que hagas nada más.</p>
        <div class="thanks__actions">
          <Button href={base + "/"} variant="dark" size="lg">Volver al inicio</Button>
        </div>
      </div>

      <div data-state-view="declined" hidden>
        <h1 class="display thanks__title thanks__title--danger">No pudimos confirmar tu pago</h1>
        <p class="thanks__lead">Si crees que esto es un error, o ya se hizo el cobro en tu cuenta, escríbenos a <a href="mailto:hola@clubdel1.org">hola@clubdel1.org</a> con la referencia de tu transacción.</p>
        <div class="thanks__actions">
          <Button href={donarUrl} variant="dark" size="lg">Intentar de nuevo</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  // Nunca confiar en el ?id= de la URL como prueba de pago — cualquiera puede
  // fabricar esa URL. Se verifica el estado real contra la API de Wompi con la
  // llave PÚBLICA (segura de exponer client-side; no es el secreto de integridad).
  async function verifyPayment() {
    const root = document.getElementById("thanks-root");
    if (!root) return;

    const views = {
      checking: root.querySelector<HTMLElement>('[data-state-view="checking"]'),
      approved: root.querySelector<HTMLElement>('[data-state-view="approved"]'),
      pending: root.querySelector<HTMLElement>('[data-state-view="pending"]'),
      declined: root.querySelector<HTMLElement>('[data-state-view="declined"]'),
    };
    function show(state: keyof typeof views) {
      for (const [key, el] of Object.entries(views)) {
        if (el) el.hidden = key !== state;
      }
    }

    const id = new URLSearchParams(location.search).get("id");
    const publicKey = root.dataset.wompiPublicKey;
    if (!id || !publicKey) { show("declined"); return; }

    try {
      const res = await fetch(`https://api.wompi.co/v1/transactions/${encodeURIComponent(id)}`, {
        headers: { Authorization: `Bearer ${publicKey}` },
      });
      if (!res.ok) { show("declined"); return; }
      const { data } = await res.json() as { data?: { id?: string; status?: string } };

      if (data?.status === "APPROVED") {
        const refEl = views.approved?.querySelector(".thanks__refval");
        const refWrap = views.approved?.querySelector<HTMLElement>("[data-thanks-ref]");
        if (refEl) refEl.textContent = data.id ?? id;
        if (refWrap) refWrap.hidden = false;
        show("approved");
      } else if (data?.status === "PENDING") {
        show("pending");
      } else {
        show("declined");
      }
    } catch {
      show("declined");
    }
  }
  document.addEventListener("astro:page-load", verifyPayment);
</script>
<style>
  .thanks__inner { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .thanks__title { font-size: clamp(34px, 6vw, 60px); color: var(--ink-900); max-width: 18ch; padding-bottom: 0.1em; }
  .thanks__title--warning { color: var(--warning); }
  .thanks__title--danger { color: var(--danger); }
  .thanks__lead { font-family: var(--font-body); font-weight: 500; font-size: clamp(16px, 2vw, 20px); color: var(--ink-900); opacity: 0.86; max-width: 50ch; }
  .thanks__ref { font-family: var(--font-mono); font-size: 12.5px; color: var(--ink-900); opacity: 0.7; }
  .thanks__refval { font-weight: 700; }
  .thanks__actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 12px; }
</style>
