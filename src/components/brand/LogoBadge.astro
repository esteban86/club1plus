---
// LogoBadge — insignia "El Club del 1+", el uso primario (piezas corporativas).
//
// MEDIDAS de la planimetría del manual, sobre malla 200×200 con R = 100:
//  · El disco verde va a SANGRE (r = 100, sin anillo exterior).
//  · El domo de tinta es un disco a 0,85 R recortado en 0,635 del diámetro (y = 127).
//  · "club" se apoya en la banda inferior; el "+" va a la misma altura que el "1"
//    y con esquinas rectas (el + es el glifo protagonista del rebrand).
// Para tamaños chicos (favicon, avatares) usar el isotipo: LogoLockup form="isotipo".
//
// variant "green": disco verde + domo tinta (default). Es la marca canónica y
//                  funciona sobre papel y sobre tinta.
// variant "dark":  disco tinta con anillo verde + 1+ y "club" verdes (invertida).
//                  Para fondos VERDES, donde el disco verde se perdería.
// glow: halo suave; ayuda a despegar la marca sobre fondos oscuros. Default false.
interface Props { size?: number; variant?: "green" | "dark"; glow?: boolean; class?: string; }
const { size = 72, variant = "green", glow = false, class: cls = "" } = Astro.props;
const uid = "lb-" + Math.random().toString(36).slice(2, 8);
---
<svg
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role="img"
  aria-label="El Club del 1+"
  class:list={["logo", `logo--${variant}`, cls]}
  style="display:inline-block;overflow:visible"
>
  <defs>
    <clipPath id={`dome-${uid}`}><rect x="0" y="0" width="200" height="127" /></clipPath>
    {glow && (
      <filter id={`glow-${uid}`} x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="7" />
      </filter>
    )}
  </defs>

  {glow && <circle class="logo__glow" cx="100" cy="100" r="97" opacity="0.5" filter={`url(#glow-${uid})`} />}

  {/* disco a sangre */}
  <circle class="logo__disc" cx="100" cy="100" r="100" />
  {variant === "dark" && <circle class="logo__ring" cx="100" cy="100" r="96" fill="none" stroke-width="5" />}
  {/* domo — disco interior (r=85) recortado en y=127 */}
  <circle class="logo__dome" cx="100" cy="100" r="85" clip-path={`url(#dome-${uid})`} />

  {/* "1+" ópticamente centrado en el domo */}
  <text class="logo__txt logo__1plus" x="64" y="116" text-anchor="middle" font-weight="900" font-size="90" letter-spacing="-4">1</text>
  <g class="logo__1plus">
    <rect x="115" y="51.5" width="20" height="66" />
    <rect x="92" y="74.5" width="66" height="20" />
  </g>

  {/* "club" ópticamente centrado en la banda */}
  <text class="logo__txt logo__club" x="100" y="171" text-anchor="middle" font-weight="900" font-size="46" letter-spacing="-1.5">club</text>
</svg>

<style>
  /* Colores y fuente vía CSS (no atributos de presentación): var() resuelve
     de forma fiable en todos los navegadores, incluido Safari. */
  .logo__txt { font-family: var(--font-display); }
  .logo__glow { fill: var(--green-400); }

  .logo--green .logo__disc  { fill: var(--green-400); }
  .logo--green .logo__dome  { fill: var(--ink-800); }
  .logo--green .logo__1plus { fill: var(--green-400); }
  .logo--green .logo__club  { fill: var(--ink-800); }

  .logo--dark .logo__disc  { fill: var(--ink-800); }
  .logo--dark .logo__ring  { stroke: var(--green-400); }
  .logo--dark .logo__dome  { fill: var(--ink-900); }
  .logo--dark .logo__1plus { fill: var(--green-400); }
  .logo--dark .logo__club  { fill: var(--green-400); }
</style>
