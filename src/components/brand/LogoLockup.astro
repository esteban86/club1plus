---
// LogoLockup — usos responsive del manual de marca (p. 15).
//
// MEDIDAS del brandbook, normalizadas con el disco a R = 100:
//  · El disco del lockup y el del isotipo comparten UNA construcción, distinta
//    a la de la insignia completa: domo r = 81 (0,81 R) recortado en y = 158,6
//    (0,586 R bajo el centro) — más profundo que el domo de la insignia, porque
//    debajo no va la banda "club".
//  · "1+" dentro: altura de caja 74, "1" con base en y = 136 sobre el eje x = 53,
//    "+" de 77 × 77 con barra de 24 — bastante más grande que el 1+ de la insignia.
//  · Lockup horizontal (viewBox 350×200): "el" / "club" / "del" en minúscula,
//    apiladas en tres líneas alineadas a la derecha en x = 123,4. Cuerpo 57,6 y
//    tracking −3,2 reproducen los anchos del manual (el 49 · club 123,4 · del 83).
//    Las líneas se posicionan por su ancho de TINTA con anclaje de inicio
//    (x 75 / 0 / 38,6): con text-anchor="end" se alinearía el avance —incluidos
//    los bearings laterales— y "club" se saldría de la caja. Bases en
//    72,3 / 124,5 / 176,6; luego 26 unidades de aire hasta el disco (cx 249,5).
//  · Lockup inline (viewBox 491×200): las mismas palabras en UNA línea desde
//    x = 0, base en y = 115,8 (altura x ópticamente centrada con el disco), con
//    el mismo aire de 26 unidades hasta el disco (cx 390,9).
//
// form:
//  "horizontal" — "el club del" en tres líneas + el disco 1+ (default). Cuando el
//                 layout pide una marca horizontal o hay menos espacio.
//  "inline"     — las mismas palabras en UNA línea + el disco. Para espacios muy
//                 anchos y bajos: cabeceras, pies, firmas de correo.
//  "isotipo"    — solo el disco. Únicamente donde ya existe recordación de marca.
//
// variant "green": disco verde, domo tinta, 1+ verde, texto tinta. Marca canónica,
//                  para fondos de papel.
// variant "dark":  disco tinta con anillo verde, 1+ y texto verdes (invertida).
//                  Para fondos VERDES u OSCUROS, donde el texto tinta se perdería.
interface Props {
  height?: number;
  form?: "horizontal" | "inline" | "isotipo";
  variant?: "green" | "dark";
  class?: string;
}
const { height = 44, form = "horizontal", variant = "green", class: cls = "" } = Astro.props;

const uid = "lk-" + Math.random().toString(36).slice(2, 8);
const iso = form === "isotipo";
const line = form === "inline";
const vbw = iso ? 200 : line ? 491 : 350;
const ox = iso ? 0 : line ? 290.9 : 149.5; // origen del disco
const cx = ox + 100;
const width = (height * vbw) / 200;
---
<svg
  width={width}
  height={height}
  viewBox={`0 0 ${vbw} 200`}
  role="img"
  aria-label={iso ? "1+" : "el club del 1+"}
  class:list={["lk", `lk--${variant}`, cls]}
  style="display:inline-block"
>
  <defs>
    <clipPath id={`dm-${uid}`}><rect x={ox} y="0" width="200" height="158.6" /></clipPath>
  </defs>

  {!iso && (
    <g class="lk__type" font-weight="900" font-size="57.6" letter-spacing="-3.2">
      {line ? (
        <text x="0" y="115.8">el club del</text>
      ) : (
        <>
          <text x="75" y="72.3">el</text>
          <text x="0" y="124.5">club</text>
          <text x="38.6" y="176.6">del</text>
        </>
      )}
    </g>
  )}

  <circle class="lk__disc" cx={cx} cy="100" r="100" />
  {variant === "dark" && <circle class="lk__ring" cx={cx} cy="100" r="96" fill="none" stroke-width="5" />}
  <circle class="lk__dome" cx={cx} cy="100" r="81" clip-path={`url(#dm-${uid})`} />

  <text class="lk__type lk__glyph" x={ox + 53} y="136" text-anchor="middle" font-weight="900" font-size="106" letter-spacing="-5">1</text>
  <g class="lk__glyph">
    <rect x={ox + 111} y="61" width="24" height="77" />
    <rect x={ox + 84.5} y="87.5" width="77" height="24" />
  </g>
</svg>

<style>
  /* Colores y fuente vía CSS (no atributos de presentación): var() resuelve
     de forma fiable en todos los navegadores, incluido Safari. */
  .lk__type { font-family: var(--font-display); }

  .lk--green .lk__type  { fill: var(--ink-800); }
  .lk--green .lk__disc  { fill: var(--green-400); }
  .lk--green .lk__dome  { fill: var(--ink-800); }
  .lk--green .lk__glyph { fill: var(--green-400); }

  .lk--dark .lk__type  { fill: var(--green-400); }
  .lk--dark .lk__disc  { fill: var(--ink-800); }
  .lk--dark .lk__ring  { stroke: var(--green-400); }
  .lk--dark .lk__dome  { fill: var(--ink-900); }
  .lk--dark .lk__glyph { fill: var(--green-400); }
</style>
