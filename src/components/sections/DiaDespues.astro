---
import Overline from "../brand/Overline.astro";
import Highlight from "../brand/Highlight.astro";
import Button from "../brand/Button.astro";
import { getLangFromUrl, getRoute } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = base + getRoute("diaDespues", lang);

// Datos verificados: SGC (magnitudes), El País 16-ago-2026 (Armenia 2026),
// Center for High Impact Philanthropy / UPenn (curva de donación), consenso de
// expertos sobre reconstrucción (BTG Pactual, prensa nacional, ago-2026).
const d = lang === "es"
  ? {
      over: "Emergencias",
      badge: "Nueva línea",
      tracks: [
        { k: "Línea 1", h: "Renta básica", where: "Moravia, Medellín" },
        { k: "Línea 2 · nueva", h: "Respuesta a emergencias", where: "Hoy: Chocó" },
      ],
      before: "Lo que salva no llega en la ",
      hl: "emergencia.",
      lead: "El 25 de enero de 1999 un sismo de magnitud 6,2 destruyó Armenia y mató a 921 personas. El 10 de agosto de 2026 un sismo mucho más fuerte —7,4— volvió a sacudirla. Esta vez no murió nadie.",
      body: "La diferencia no fue la ayuda que llegó en enero de 1999. Fueron los 27 años siguientes: norma sismorresistente, interventoría obligatoria, reconstrucción sostenida cuando ya nadie estaba mirando.",
      cols: [
        { year: "1999", mag: "Magnitud 6,2", dead: "921", label: "personas murieron" },
        { year: "2026", mag: "Magnitud 7,4", dead: "0", label: "personas murieron" },
      ],
      clockA: "La donación de emergencia se agota en",
      clockAv: "6 meses",
      clockB: "La reconstrucción toma",
      clockBv: "4 a 6 años",
      clockNote: "Entre esos dos números vive una familia.",
      pledge: "Por eso vamos a destinar parte de lo que reunimos al Chocó — el departamento con mayor pobreza monetaria del país, que ya estaba en la trampa antes del 10 de agosto. No con operación propia, sino financiando a quien ya está en el territorio. Cuenta separada y corte publicado cada mes.",
      cta: "Cómo lo vamos a hacer",
      src: "Fuentes: Servicio Geológico Colombiano · El País, 16 de agosto de 2026 · Center for High Impact Philanthropy, Universidad de Pensilvania.",
    }
  : {
      over: "Emergencies",
      badge: "New track",
      tracks: [
        { k: "Track 1", h: "Basic income", where: "Moravia, Medellín" },
        { k: "Track 2 · new", h: "Emergency response", where: "Today: Chocó" },
      ],
      before: "What saves lives doesn't arrive in the ",
      hl: "emergency.",
      lead: "On 25 January 1999 a magnitude 6.2 earthquake destroyed Armenia, Colombia, and killed 921 people. On 10 August 2026 a far stronger quake — 7.4 — shook it again. This time nobody died.",
      body: "The difference wasn't the aid that arrived in January 1999. It was the 27 years that followed: seismic building codes, mandatory technical oversight, sustained rebuilding long after everyone stopped watching.",
      cols: [
        { year: "1999", mag: "Magnitude 6.2", dead: "921", label: "people died" },
        { year: "2026", mag: "Magnitude 7.4", dead: "0", label: "people died" },
      ],
      clockA: "Emergency giving dries up in",
      clockAv: "6 months",
      clockB: "Rebuilding takes",
      clockBv: "4 to 6 years",
      clockNote: "A family lives in the gap between those two numbers.",
      pledge: "That's why we're directing part of what we raise to Chocó — the Colombian department with the highest monetary poverty rate, already caught in the trap long before 10 August. Not by running our own operation, but by funding those already in the territory. Separate account, statement published monthly.",
      cta: "How we're going to do it",
      src: "Sources: Colombian Geological Survey · El País, 16 August 2026 · Center for High Impact Philanthropy, University of Pennsylvania.",
    };
---
<section class="ground-ink section dd">
  <div class="container">
    <div class="dd__head">
      <Overline tone="green">{d.over}</Overline>
      <span class="dd__badge">{d.badge}</span>
    </div>

    <div class="dd__tracks reveal">
      {d.tracks.map((t, i) => (
        <div class={`dtk ${i === 1 ? "dtk--now" : ""}`}>
          <span class="dtk__k">{t.k}</span>
          <span class="dtk__h">{t.h}</span>
          <span class="dtk__w">{t.where}</span>
        </div>
      ))}
    </div>

    <h2 class="display dd__title">{d.before}<Highlight variant="green">{d.hl}</Highlight></h2>
    <p class="dd__lead">{d.lead}</p>

    <div class="dd__compare">
      {d.cols.map((c, i) => (
        <div class={`ddc reveal ${i === 1 ? "ddc--now" : ""}`}>
          <span class="ddc__year">{c.year}</span>
          <span class="ddc__mag">{c.mag}</span>
          <span class="ddc__dead">{c.dead}</span>
          <span class="ddc__label">{c.label}</span>
        </div>
      ))}
    </div>

    <p class="dd__body">{d.body}</p>

    <div class="dd__clock reveal">
      <div class="ddk">
        <span class="ddk__k">{d.clockA}</span>
        <span class="ddk__v">{d.clockAv}</span>
      </div>
      <div class="ddk">
        <span class="ddk__k">{d.clockB}</span>
        <span class="ddk__v ddk__v--green">{d.clockBv}</span>
      </div>
    </div>
    <p class="dd__note">{d.clockNote}</p>

    <p class="dd__pledge reveal">{d.pledge}</p>

    <div class="dd__cta"><Button href={url} variant="primary" size="lg">{d.cta} →</Button></div>
    <p class="dd__src">{d.src}</p>
  </div>
</section>
<style>
  .dd__head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .dd__badge { font-family: var(--font-mono); font-weight: 700; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-900); background: var(--green-400); border-radius: 999px; padding: 4px 12px; }
  .dd__tracks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 24px; max-width: 620px; }
  .dtk { display: flex; flex-direction: column; gap: 3px; border: 1px solid var(--ink-500); border-radius: var(--radius-md); padding: 14px 16px; background: rgba(255, 255, 255, 0.03); }
  .dtk--now { border-color: var(--green-400); background: rgba(43, 224, 111, 0.08); }
  .dtk__k { font-family: var(--font-mono); font-weight: 700; font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--green-400); }
  .dtk__h { font-family: var(--font-display); font-weight: 800; font-size: 16px; color: var(--paper-50); margin-top: 2px; }
  .dtk__w { font-family: var(--font-mono); font-weight: 500; font-size: 11.5px; color: var(--text-on-dark-muted); }
  .dd__title { font-size: clamp(32px, 5.5vw, 52px); color: var(--paper-50); max-width: 20ch; margin-top: 28px; line-height: 1.08; padding-bottom: 0.1em; }
  .dd__lead { font-family: var(--font-body); font-weight: 500; font-size: clamp(16px, 2vw, 19px); line-height: 1.55; color: var(--text-on-dark-muted); max-width: 58ch; margin-top: 16px; }
  .dd__compare { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 40px; max-width: 620px; }
  .ddc { display: flex; flex-direction: column; gap: 4px; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--ink-500); border-radius: var(--radius-md); padding: 24px; }
  .ddc--now { border-color: var(--green-400); background: rgba(43, 224, 111, 0.06); }
  .ddc__year { font-family: var(--font-mono); font-weight: 700; font-size: 12px; letter-spacing: 0.1em; color: var(--green-400); }
  .ddc__mag { font-family: var(--font-body); font-weight: 500; font-size: 13.5px; color: var(--text-on-dark-muted); }
  .ddc__dead { font-family: var(--font-display); font-weight: 900; font-size: clamp(44px, 8vw, 64px); line-height: 1; color: var(--paper-50); margin-top: 10px; letter-spacing: -0.03em; }
  .ddc--now .ddc__dead { color: var(--green-400); }
  .ddc__label { font-family: var(--font-body); font-weight: 500; font-size: 13.5px; color: var(--text-on-dark-muted); }
  .dd__body { font-family: var(--font-body); font-weight: 500; font-size: clamp(15px, 2vw, 17.5px); line-height: 1.6; color: var(--text-on-dark-muted); max-width: 58ch; margin-top: 32px; }
  .dd__clock { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 40px; max-width: 620px; }
  .ddk { display: flex; flex-direction: column; gap: 6px; }
  .ddk__k { font-family: var(--font-body); font-weight: 500; font-size: 14px; color: var(--text-on-dark-muted); }
  .ddk__v { font-family: var(--font-display); font-weight: 800; font-size: clamp(24px, 4vw, 32px); line-height: 1.1; color: var(--paper-50); }
  .ddk__v--green { color: var(--green-400); }
  .dd__note { font-family: var(--font-display); font-weight: 800; font-size: clamp(18px, 2.6vw, 24px); color: var(--paper-50); margin-top: 26px; max-width: 30ch; line-height: 1.3; }
  .dd__pledge { font-family: var(--font-body); font-weight: 500; font-size: clamp(15px, 2vw, 17px); line-height: 1.65; color: var(--text-on-dark-muted); max-width: 58ch; margin-top: 24px; border-left: 3px solid var(--green-400); padding-left: 18px; }
  .dd__cta { margin-top: 34px; }
  .dd__src { font-family: var(--font-mono); font-size: 11px; line-height: 1.6; color: var(--text-on-dark-muted); margin-top: 28px; max-width: 70ch; }
  @media (max-width: 720px) { .dd__compare, .dd__clock, .dd__tracks { grid-template-columns: 1fr; } }
</style>
