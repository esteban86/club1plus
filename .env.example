# Copiar a .env (nunca se commitea) y completar los valores reales.

# Measurement ID de GA4 (panel de Google Analytics → Administrador → Flujos de datos).
# Vacío = el sitio no carga ningún script de analítica ni muestra el banner de consentimiento.
PUBLIC_GA_MEASUREMENT_ID=

# Llave pública de Wompi (panel de Wompi → Desarrolladores). Segura de exponer
# client-side (no es el secreto de integridad). Vacío = /gracias nunca muestra
# éxito, aunque llegue un ?id= válido — falla cerrado, no abierto.
PUBLIC_WOMPI_PUBLIC_KEY=
